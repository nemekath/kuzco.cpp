#!/usr/bin/env bash
# pre-commit — Block commits that leak local paths or secrets.
#
# Scans staged text files for forbidden patterns. Binary files are skipped.
# To bypass in emergencies: git commit --no-verify (but don't).
#
# Local extension: drop additional patterns into .git/hooks/local-patterns
# (one rule per line, format: "regex|description"). That file is per-clone
# and is never tracked by git.

set -euo pipefail

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
if [[ "$CURRENT_BRANCH" == "master" ]]; then
    echo "BLOCKED: Committing on 'master' is not allowed."
    echo "  The master branch tracks upstream. Switch to 'tmac' or a feature branch."
    echo "  Use: git checkout tmac"
    exit 1
fi

# ── Generic forbidden patterns (case-insensitive grep -E) ──────────────
# These are intentionally generic so they catch common mistakes without
# revealing project-specific identifiers. Add project-specific rules to
# .git/hooks/local-patterns instead.
RULES=(
  '(^|[^a-zA-Z0-9_])/home/[a-z][a-z0-9_-]*/|Local path leak (home directory)'
  '(^|[^a-zA-Z0-9_])/mnt/[a-z][a-z0-9_-]+/|Local path leak (mount path)'
  '(^|[^a-zA-Z0-9_])/Users/[a-z][a-z0-9_-]*/|Local path leak (macOS home)'
  'Co-Authored-By:.*Claude|AI authoring attribution'
  'Co-Authored-By:.*Anthropic|AI authoring attribution'
  'Co-Authored-By:.*noreply@anthropic|AI authoring attribution'
  'sk-[a-zA-Z0-9]{20,}|Secret leak (API key)'
  'ghp_[a-zA-Z0-9]{36}|Secret leak (GitHub PAT)'
  'github_pat_[a-zA-Z0-9_]{80,}|Secret leak (GitHub fine-grained PAT)'
  'hf_[a-zA-Z0-9]{34}|Secret leak (HuggingFace token)'
  'AKIA[0-9A-Z]{16}|Secret leak (AWS access key)'
)

# Load optional local pattern extensions (per-clone, never tracked).
LOCAL_PATTERNS_FILE="$(git rev-parse --git-dir)/hooks/local-patterns"
if [[ -f "$LOCAL_PATTERNS_FILE" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    RULES+=("$line")
  done < "$LOCAL_PATTERNS_FILE"
fi

EXCLUDE_FILES="scripts/hooks/pre-commit|scripts/scan-leaks.sh"

ERRORS=0

BINARY_FILES=$(git diff --cached --numstat --diff-filter=d -z \
  | tr '\0' '\n' \
  | awk -F'\t' '$1 == "-" { print $3 }')
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d \
  | grep -vE "$EXCLUDE_FILES" || true)
if [[ -n "$BINARY_FILES" ]]; then
  STAGED_FILES=$(echo "$STAGED_FILES" | grep -vxFf <(echo "$BINARY_FILES") || true)
fi

[[ -z "$STAGED_FILES" ]] && exit 0

for rule in "${RULES[@]}"; do
  pattern="${rule%%|*}"
  description="${rule#*|}"

  matches=""
  while IFS= read -r file; do
    if git show ":0:$file" 2>/dev/null | grep -qiE "$pattern"; then
      matches+="$file"$'\n'
    fi
  done <<< "$STAGED_FILES"
  matches="${matches%$'\n'}"

  if [[ -n "$matches" ]]; then
    echo "BLOCKED: $description"
    echo "  Files:"
    echo "$matches" | sed 's/^/    /'
    echo ""
    ERRORS=$((ERRORS + 1))
  fi
done

MAX_SIZE=$((5 * 1024 * 1024))
LARGE_FILES=""
if [[ -n "$STAGED_FILES" ]]; then
  while IFS= read -r file; do
    size=$(git cat-file -s ":0:$file" 2>/dev/null || echo 0)
    if [[ "$size" -gt "$MAX_SIZE" ]]; then
      size_mb=$(awk -v s="$size" 'BEGIN { printf "%.1f", s / 1048576 }')
      LARGE_FILES+="    $file (${size_mb} MB)"$'\n'
      ERRORS=$((ERRORS + 1))
    fi
  done <<< "$STAGED_FILES"
fi

if [[ -n "$LARGE_FILES" ]]; then
  echo "BLOCKED: Large file(s) staged (limit: 5 MB)"
  echo "  Files:"
  echo "$LARGE_FILES"
fi

if [[ $ERRORS -gt 0 ]]; then
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "Commit blocked: $ERRORS violation(s) found."
  echo "Fix the files above, or use --no-verify to bypass."
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  exit 1
fi
